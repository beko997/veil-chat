# Local development only. Change these values for your own environment.
DATABASE_URL=postgresql://veil_chat:veil_chat_dev@127.0.0.1:5432/veil_chat
POSTGRES_DB=veil_chat
POSTGRES_USER=veil_chat
POSTGRES_PASSWORD=veil_chat_dev
DB_PORT=5432
DB_BIND_ADDRESS=127.0.0.1

# Local app ports
PORT=3001
VITE_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:3001

# Docker Compose app deployment
APP_PORT=3000
APP_BIND_ADDRESS=0.0.0.0
CONTAINER_DATABASE_URL=postgresql://veil_chat:veil_chat_dev@postgres:5432/veil_chat

# Maximum original attachment size in MiB (default: 10)
MAX_UPLOAD_SIZE_MB=10

# New attachments require an S3-compatible bucket provider: r2 or b2
MEDIA_STORAGE_PROVIDER=
# Optional local staging/cache directory; default: ../../.data/veil-chat-media
MEDIA_LOCAL_STORAGE_DIR=

# Cloudflare R2 (set MEDIA_STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override; normally derived from R2_ACCOUNT_ID
R2_ENDPOINT=

# Backblaze B2 (set MEDIA_STORAGE_PROVIDER=b2)
B2_BUCKET=
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=
# Optional override; normally derived from B2_REGION
B2_ENDPOINT=
